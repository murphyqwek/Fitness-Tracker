# Local image tags; use the same tags in docker build.
IMAGE_NAME=fitness-tracker-api:local
ANALYTICS_IMAGE_NAME=fitness-tracker-analytics:local

DB_NAME=fitness_tracker_db
DB_USER_APP=postgres
DB_PASSWORD_APP=replace_with_local_database_password
DB_OUT_PORT=5432
DB_MAX_POOL_SIZE=4

# Redis and Kafka run on the monitoring server, reachable through WireGuard.
INFRA_WIREGUARD_IP=10.50.0.2
# Must match REDIS_PASSWORD in Docker/infrastructure/.env.
REDIS_PASSWORD=replace_with_redis_password
Kafka_Analytics_GroupId=fitness-analytics-local

JWT_PUBLIC_KEY_HOST_PATH=./.local/keys/jwt_public.pem
JWT_PRIVATE_KEY_HOST_PATH=./.local/keys/jwt_private.pem
JWT_PUBLIC_KEY_CONTAINER_PATH=/run/secrets/jwt_public.pem
JWT_PRIVATE_KEY_CONTAINER_PATH=/run/secrets/jwt_private.pem

# Application server's WireGuard address for the metrics port in docker-compose.yml.
APP_WIREGUARD_IP=10.50.0.1

logging {
  level = "info"
}

discovery.docker "apps" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"

  filter {
    name   = "name"
    values = ["^/app-container$", "^/analytcs-container$"]
  }
}

discovery.relabel "apps" {
  targets = discovery.docker.apps.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/app-container"
    target_label  = "service_name"
    replacement   = "fitness-api"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/analytcs-container"
    target_label  = "service_name"
    replacement   = "fitness-analytics"
  }
}

// Read stdout/stderr via Docker API; read positions are kept in alloy_data.
loki.source.docker "apps" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.apps.output
  labels     = { environment = "production", host = "fitness-app" }
  forward_to = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url = "http://10.50.0.2:3100/loki/api/v1/push"
  }
}
